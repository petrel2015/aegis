#!/usr/bin/env python3
import sys,json,os,base64,hashlib
from pathlib import Path
p=Path(os.environ['FAKE_GH_ROOT']); sf=p/'state.json'; meta=json.loads((p/'meta.json').read_text()); route=next(x for x in sys.argv if x.startswith('repos/')); method=sys.argv[sys.argv.index('-X')+1]
if '/contents/' in route:
 raw=sf.read_bytes(); sha=hashlib.sha1(raw).hexdigest()
 if method=='GET': print(json.dumps({'content':base64.b64encode(raw).decode(),'sha':sha}))
 else:
  data=json.load(sys.stdin)
  if data.get('sha')!=sha: sys.exit(1)
  sf.write_bytes(base64.b64decode(data['content'])); print('{}')
elif '/issues/' in route: print(json.dumps({'state':meta['issue_state']}))
elif '/pulls/' in route: print(json.dumps({'head':{'sha':meta['head']},'base':{'sha':meta['base'],'repo':{'full_name':'test/project'}},'state':'closed' if meta.get('merged') else 'open','draft':False,'merged':meta.get('merged',False)}))
else: sys.exit(3)
